# NYVEX supports Gemini free-tier cloud AI (recommended) or OpenAI.
# If GEMINI_API_KEY is set, NYVEX uses Gemini first.
# Keep real keys in .env / Render Environment only. Never commit or share them.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=3000
NYVEX_ACCESS_PASSWORD=choose-a-long-unique-password
